# ---------- Public address ----------
# Hosts Caddy serves over HTTPS. Add your LAN IP to test on phones: "localhost, 192.168.1.50"
SITE_ADDRESS=localhost

# ---------- Admin login (CHANGE THESE) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign admin sessions, e.g. `openssl rand -hex 32`
AUTH_SECRET=change-me
AUTH_TOKEN_TTL_HOURS=12

# ---------- Database ----------
POSTGRES_DB=photo_db
POSTGRES_USER=photo_user
POSTGRES_PASSWORD=photo_password
DATABASE_URL=postgresql+psycopg://photo_user:photo_password@postgres:5432/photo_db

REDIS_URL=redis://redis:6379/0

# ---------- Object storage (any S3-compatible: MinIO locally, Cloudflare R2 / S3 in production) ----------
S3_ENDPOINT=http://minio:9000
# Browser-facing base for presigned URLs. Empty = same origin via Caddy (https://<host>/storage)
S3_PUBLIC_URL=
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_password
S3_BUCKET=photos
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password

# ---------- Privacy ----------
# Default lifetime of a new event; expired events are deleted automatically (photos + faces)
RETENTION_DAYS_DEFAULT=90
# Default similarity needed to count as the same person (each event can override / auto-calibrate)
SEARCH_DEFAULT_THRESHOLD=0.4

# ---------- Rate limits per IP ----------
RATE_SEARCH_PER_MINUTE=10
RATE_SEARCH_PER_DAY=200
RATE_LOGIN_PER_MINUTE=5

# ---------- Face detection ----------
# Large photos are scanned at up to this detector size (finds small faces in group shots; slower)
FACE_DET_SIZE_MAX=1280
