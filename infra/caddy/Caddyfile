# One HTTPS origin for everything:
#   /          -> Next.js web
#   /api/*     -> FastAPI (prefix stripped)
#   /storage/* -> MinIO (prefix stripped; presigned signatures stay valid because Host is preserved)
#
# SITE_ADDRESS can list several hosts, e.g. "localhost, 192.168.1.50" to open it from phones on
# your Wi-Fi. CADDY_TLS=internal (default) = Caddy's own local CA (browsers warn until you trust it).
# On a public server set CADDY_TLS to an e-mail address to get a real Let's Encrypt certificate
# (needs ports 80/443 open and a public name, e.g. 34-87-12-34.sslip.io — see docs/deploy-gcp.md),
# or to "/etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key" for a Cloudflare Origin Certificate.
{
	admin off
	servers {
		# Behind Cloudflare's proxy, set TRUSTED_PROXIES to Cloudflare's IP ranges so {client_ip}
		# is the visitor (from CF-Connecting-IP) instead of a Cloudflare edge — rate limits need it.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		# Connections that send their headers very slowly only tie up the server.
		timeouts {
			read_header 15s
			idle 2m
		}
		max_header_size 32KB
	}
}

(app) {
	encode zstd gzip

	# Only signed-in organizers upload big batches; a stranger's request has no reason to be large.
	@attendee path /api/public/* /api/auth/*
	request_body @attendee {
		max_size 25MB
	}
	request_body {
		max_size 1100MB
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
			# While a container is being replaced, hold requests a moment instead of answering 502.
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	handle_path /storage/* {
		# Browsers only ever read photos through signed links; nothing else of MinIO is public.
		@write not method GET HEAD
		respond @write 405
		respond /minio/* 404
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

{$SITE_ADDRESS:localhost} {
	tls {$CADDY_TLS:internal}
	import app
	header Strict-Transport-Security "max-age=31536000"
}

# Plain HTTP for this machine only: compose publishes it as 127.0.0.1:3000 -> :8080.
# localhost is still a secure context, so the camera works here too.
http://localhost:8080 {
	import app
}

# Extra hostnames (subdomains, redirects, the MinIO console…): drop *.caddy files into
# infra/caddy/sites/ — see the examples there and docs/deploy-gcp.md.
import sites/*.caddy
